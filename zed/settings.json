// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  // editor
  "agent": {
    "tool_permissions": {
      "tools": {
        "skill": {
          "default": "allow"
        },
        "terminal": {
          "default": "allow"
        },
        "fetch": {
          "default": "allow"
        }
      }
    },
    "sandbox_permissions": {
      "write_paths": [
        {
          "requested": "/Users/classting-won/.config/zed",
          "resolved": "/Users/classting-won/.config/zed"
        }
      ],
      "network_hosts": [
        "zed.dev"
      ]
    },
    "default_model": {
      "provider": "openai",
      "model": "gpt-5.6-terra",
      "enable_thinking": true,
      "effort": "medium"
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "base_keymap": "JetBrains",
  "ssh_connections": [],
  "edit_predictions": {
    "disabled_globs": ["*.rs"],
    "enabled_in_text_threads": false
  },

  "terminal": {
    "shell": "system"
  },

  // langs
  "languages": {
    "YAML": {
      "formatter": "prettier",
      "format_on_save": "off"
    }
  },

  // appearance
  "ui_font_size": 15,
  "buffer_font_size": 12.5,
  "buffer_font_family": "JetBrains Mono",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark"
  },

  // vim specific settings
  "vim_mode": true,
  "vim": { "use_system_clipboard": "never" },
  "tab_bar": { "show": false },
  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false
  },
  "cursor_blink": false,
  "relative_line_numbers": "enabled",
  "scrollbar": { "show": "never" },
  "vertical_scroll_margin": 0,
  "scroll_beyond_last_line": "off",
  "command_aliases": {
    "W": "w",
    "Wq": "wq",
    "Q": "q"
  },

  "file_types": {
    "HTML": ["hbs"]
  }
}
