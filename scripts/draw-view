#!/usr/bin/env python3
"""draw-view - draw 팬 안에서 도는 뷰어. `draw` 엔진이 부른다.

DIR/cur.svg 또는 DIR/cur.png 를 지켜보다가 DIR/stamp 가 바뀌거나 팬 크기가 바뀌면
팬 픽셀 크기에 맞춰 1x 로 래스터화해 kitty graphics protocol 로 다시 그린다.
(Rex 는 kitty 이미지를 point 해상도로 다시 샘플링하므로 2x 로 그리면 흐려진다.)
그린 결과는 DIR/last 에 'ok <w>x<h> <cols>x<rows>' 로 남긴다.
팬 맨 아래 줄은 안내 줄이다. 팬에 포커스를 두고 c 를 누르면 그림을 2x PNG 로 클립보드에 복사한다.
"""
import atexit, base64, fcntl, os, select, signal, struct, subprocess, sys, termios, time, tty

DIR = sys.argv[1]
STAMP, LAST = os.path.join(DIR, "stamp"), os.path.join(DIR, "last")
out = sys.stdout


def winsize():
    rows, cols, xp, yp = struct.unpack("HHHH", fcntl.ioctl(1, termios.TIOCGWINSZ, b"\0" * 8))
    cw = xp // cols if xp and cols else 8
    ch = yp // rows if yp and rows else 16
    return rows, cols, cw, ch


def png_size(path):
    with open(path, "rb") as f:
        head = f.read(24)
    return struct.unpack(">II", head[16:24])


def rasterize(W, H):
    svg, png = os.path.join(DIR, "cur.svg"), os.path.join(DIR, "cur.png")
    dst = os.path.join(DIR, "view.png")
    if os.path.exists(svg) and os.path.getmtime(svg) >= (os.path.getmtime(png) if os.path.exists(png) else 0):
        subprocess.run(["rsvg-convert", "-a", "-w", str(W), svg, "-o", dst], check=True)
        if png_size(dst)[1] > H:  # 세로가 넘치면 높이에 맞춘다
            subprocess.run(["rsvg-convert", "-a", "-h", str(H), svg, "-o", dst], check=True)
    else:  # PNG 는 넘칠 때만 줄인다(확대하면 흐려짐)
        subprocess.run(["magick", png, "-resize", f"{W}x{H}>", dst], check=True)
    return dst


def render():
    rows, cols, cw, ch = winsize()
    W, H = cols * cw, (rows - 1) * ch
    try:
        path = rasterize(W, H)
    except Exception as e:  # noqa: BLE001
        out.write(f"\033[2J\033[Hdraw: 그리기 실패: {e}\n"); out.flush()
        open(LAST, "w").write(f"ERR {e}\n")
        return
    pw, ph = png_size(path)
    c, r = max(1, -(-pw // cw)), max(1, -(-ph // ch))
    data = base64.standard_b64encode(open(path, "rb").read())
    out.write("\033[?25l\033_Ga=d,d=A,q=2\033\\\033[2J\033[H")
    first = True
    while data:
        chunk, data = data[:4096], data[4096:]
        ctrl = f"a=T,f=100,q=2,C=1,c={c},r={r}," if first else ""
        out.write(f"\033_G{ctrl}m={1 if data else 0};{chunk.decode()}\033\\")
        first = False
    out.flush()
    status("c 복사")
    open(LAST, "w").write(f"ok {pw}x{ph} {cols}x{rows}\n")


def status(msg, color="38;2;130;139;184"):
    """팬 맨 아래 줄(그림이 쓰지 않는 줄)에 안내를 쓴다."""
    rows = winsize()[0]
    out.write(f"\033[{rows};1H\033[2K\033[{color}m{msg}\033[0m"); out.flush()


def copy():
    """화면용 1x 가 아니라 2x 로 다시 렌더해 클립보드에 넣는다(붙여 넣을 때 선명하게)."""
    svg, png = os.path.join(DIR, "cur.svg"), os.path.join(DIR, "cur.png")
    dst = os.path.join(DIR, "copy.png")
    try:
        if os.path.exists(svg):
            subprocess.run(["rsvg-convert", "-z", "2", svg, "-o", dst], check=True)
        elif os.path.exists(png):
            dst = png
        else:
            return status("복사할 그림이 없습니다", "38;2;255;199;119")
        subprocess.run(["osascript", "-e", f'set the clipboard to (read (POSIX file "{dst}") as «class PNGf»)'],
                       check=True, capture_output=True)
        w, h = png_size(dst)
        status(f"복사됨 {w}x{h}", "38;2;195;232;141")
    except Exception as e:  # noqa: BLE001
        status(f"복사 실패: {e}", "38;2;255;117;127")


resized = False


def on_winch(*_):
    global resized
    resized = True


signal.signal(signal.SIGWINCH, on_winch)
tty_in = sys.stdin.isatty()
if tty_in:  # 키를 한 글자씩, 화면에 찍히지 않게 받는다
    saved = termios.tcgetattr(0)
    atexit.register(termios.tcsetattr, 0, termios.TCSADRAIN, saved)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))
    tty.setcbreak(0)
seen = None
while True:
    try:
        m = os.path.getmtime(STAMP)
    except FileNotFoundError:
        m = None
    if m != seen or resized:
        seen, resized = m, False
        if m is not None:
            render()
    if not tty_in:
        time.sleep(0.2)
        continue
    try:
        ready = select.select([0], [], [], 0.2)[0]
    except InterruptedError:  # SIGWINCH
        continue
    if ready and os.read(0, 32).lower().startswith(b"c"):
        copy()
