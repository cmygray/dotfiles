#!/bin/zsh
# harness shim — BusyBox 패턴 (argv[0] 분기: claude | codex)
#
# 역할 (mangkyu.tistory.com/467 shim 아키텍처 착안):
#   1. Codex 스킬 심링크 자가치유 — super-ct marketplace 클론을 가리키도록 (ms 단위, 포그라운드)
#   2. 스로틀된 백그라운드 sync — marketplace 클론 + Claude 플러그인 갱신 (TTL 12h)
#   3. PATH에서 자신을 제거하고 진짜 바이너리로 exec (투명성)
#
# 설치: .zshrc에서 PATH 최앞단에 dotfiles/shim/bin 추가
#   export PATH="$HOME/dotfiles/shim/bin:$PATH"

emulate -L zsh
SHIM_DIR="${0:A:h}"
CMD="${0:t}"

# ── 재귀 방지 + 진짜 바이너리 해석 ──────────────────────────────
path=("${(@)path:#$SHIM_DIR}")
REAL_BIN="$(command -v "$CMD")" || { print -u2 "shim: 진짜 $CMD 를 PATH에서 못 찾음"; exit 127; }
REAL_CLAUDE="$(command -v claude)"   # sync에 사용 (없으면 sync 생략)

# ── 0. 호출 추적 (발동 여부 진단용 — tail ~/.cache/ct-shim/invocations.log) ──
TRACE="$HOME/.cache/ct-shim/invocations.log"
mkdir -p "${TRACE:h}"
print -r -- "$(date '+%F %T') cmd=$CMD ppid=$PPID parent=$(ps -o comm= -p $PPID 2>/dev/null) tty=${TTY:-none}" >> "$TRACE"
tail -n 200 "$TRACE" > "$TRACE.tmp" && mv "$TRACE.tmp" "$TRACE"   # 최근 200줄 유지

# ── 1. Codex 스킬 심링크 자가치유 ───────────────────────────────
MARKET="$HOME/.claude/plugins/marketplaces/superct/claude-plugins"
typeset -A CODEX_SKILL_LINKS=(
  ship     "$MARKET/dev/codex/skills/ship"
  dynamodb "$MARKET/common/codex/skills/dynamodb"
)
typeset -A CODEX_AGENT_LINKS=(
  runner.toml   "$MARKET/dev/codex/agents/runner.toml"
  babysit.toml  "$MARKET/dev/codex/agents/babysit.toml"
  verifier.toml "$MARKET/qa/codex/agents/verifier.toml"
  ct-actor.toml "$MARKET/qa/codex/agents/ct-actor.toml"
)
heal() {  # heal <base-dir> <name> <target>
  local link="$1/$2" target="$3"
  [[ "$(readlink "$link" 2>/dev/null)" == "$target" ]] || ln -sfn "$target" "$link"
}
if [[ -d "$MARKET" ]]; then
  mkdir -p "$HOME/.codex/skills" "$HOME/.codex/agents"
  for name target in "${(@kv)CODEX_SKILL_LINKS}"; do heal "$HOME/.codex/skills" "$name" "$target"; done
  for name target in "${(@kv)CODEX_AGENT_LINKS}"; do heal "$HOME/.codex/agents" "$name" "$target"; done
fi

# ── 2. 스로틀된 백그라운드 sync (TTL 12h) ───────────────────────
CACHE="$HOME/.cache/ct-shim"; STAMP="$CACHE/last-sync"; TTL=$((12 * 3600))
mkdir -p "$CACHE"
now=$(date +%s); last=$(stat -f %m "$STAMP" 2>/dev/null || print 0)
if (( now - last > TTL )) && [[ -n "$REAL_CLAUDE" ]]; then
  touch "$STAMP"
  {
    "$REAL_CLAUDE" plugin marketplace update superct
    for pl in common@superct dev@superct qa@superct; do "$REAL_CLAUDE" plugin update "$pl"; done
    command -v uv >/dev/null && uv tool upgrade ct-cli   # ct CLI — git main 소스 재해석
  } &> "$CACHE/sync.log" &!
fi

# ── 3. 진짜 바이너리로 교체 ─────────────────────────────────────
exec "$REAL_BIN" "$@"
