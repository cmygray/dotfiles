  "skillOverrides": {
    "check": "off",
    "write": "off",
    "ui": "off",
    "change-profile-image": "off",
    "company-brief": "off",
    "ktx-analytics": "off",
    "orchestration": "off",
    "orca-cli": "off",
    "computer-use": "off",
    "plannotator-compound": "off",
    "hunt": "off",
    "health": "off",
    "think": "off",
    "design-doc": "off"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '$HOME/dotfiles/claude/notification-wrapper.sh'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
