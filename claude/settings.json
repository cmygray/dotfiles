{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "FIGMA_TOKEN": "__REDACTED__",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git *)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "check": "off",
    "write": "off",
    "ui": "off",
    "change-profile-image": "off",
    "company-brief": "off",
    "ktx-analytics": "off"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '$HOME/dotfiles/claude/notification-wrapper.sh'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '$HOME/dotfiles/claude/hooks/log-english-prompt.sh'"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/classting-won/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/classting-won/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/classting-won/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/classting-won/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c '$HOME/dotfiles/claude/hooks/pre-push-gate.sh'"
          },
          {
            "type": "command",
            "command": "sh -c '$HOME/dotfiles/claude/hooks/require-issue-link.sh'"
          },
          {
            "type": "command",
            "command": "sh -c '$HOME/dotfiles/claude/hooks/ddb-readonly-gate.sh'"
          },
          {
            "type": "command",
            "command": "sh -c '$HOME/dotfiles/claude/hooks/block-node-modules-symlink.sh'"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f '/Users/classting-won/.orca/agent-hooks/claude-hook.sh' ] && [ -r '/Users/classting-won/.orca/agent-hooks/claude-hook.sh' ] && [ -x '/Users/classting-won/.orca/agent-hooks/claude-hook.sh' ]; then /bin/sh '/Users/classting-won/.orca/agent-hooks/claude-hook.sh'; else cat >/dev/null 2>&1 || :; fi",
